{
  "name": "anidle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "ffmpeg-static": true
  },
  "scripts": {
