# Salin jadi .env (lokal) atau isi di Vercel / GitHub Secrets (produksi). Jangan commit .env!

# App MAL (https://myanimelist.net/apiconfig). Lokal boleh pakai app playground,
# produksi pakai app kedua dengan redirect https://anidle.velvetaco.dev/oauth/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Harus sama persis dengan "App Redirect URL" app MAL. /oauth/callback di-rewrite ke /api/oauth/callback.
MAL_REDIRECT_URI=http://localhost:3000/oauth/callback

# Lokal: file SQLite. Produksi: libsql://<db>-<org>.turso.io + token.
TURSO_DATABASE_URL=file:data/anidle.db
TURSO_AUTH_TOKEN=

# Acak, minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
TOKEN_ENC_KEY=

# Username MAL yang boleh main, dipisah koma.
ALLOWED_USERS=
# Username yang list completed-nya masuk pool (default: ALLOWED_USERS).
POOL_USERS=

# Opsional. Default https://jikan.lucashdo.com
JIKAN_BASE_URL=

# Hanya lokal: aktifkan /api/dev/login?user=<username> untuk tes tanpa OAuth. Tidak pernah aktif di Vercel.
ANIDLE_DEV_LOGIN=
