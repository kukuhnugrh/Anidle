# Salin jadi .env (lokal) atau isi di Vercel / GitHub Secrets (produksi). Jangan commit .env!

# App MAL (https://myanimelist.net/apiconfig). Lokal boleh pakai app playground,
# produksi pakai app kedua dengan redirect https://anidle.velvetaco.dev/oauth/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Harus sama persis dengan "App Redirect URL" app MAL. /oauth/callback di-rewrite ke /api/oauth/callback.
MAL_REDIRECT_URI=http://localhost:3000/oauth/callback

# Lokal: file SQLite. Produksi: libsql://<db>-<org>.turso.io + token.
TURSO_DATABASE_URL=file:data/anidle.db
TURSO_AUTH_TOKEN=

# Acak, minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
TOKEN_ENC_KEY=

# Username MAL yang list completed-nya membentuk pool bersama (harian, semua, teman, bareng), dipisah koma.
# Akun lain yang menghubungkan MAL hanya dapat pool "saya" miliknya sendiri.
POOL_USERS=

# Username akun Anidle (bukan MAL) yang boleh membuka #/admin (review media), dipisah koma.
ADMIN_USERS=

# Opsional. Default https://jikan.lucashdo.com
JIKAN_BASE_URL=

# Cloudflare R2 (media, mulai M3). Hanya dipakai pipeline: isi di .env lokal + GitHub Secrets, BUKAN di Vercel.
# Account API token, permission Object Read & Write, khusus bucket ini.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anidle-media
# URL publik bucket (custom domain). Dipakai pipeline untuk menyimpan URL media dan oleh web untuk memutar/menampilkan.
MEDIA_BASE_URL=https://media.velvetaco.dev
